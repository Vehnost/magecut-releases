    {
      "name": "magecut_set_keyframes",
      "description": "Replace only named scalar channels; keep all other channels. Times are element-local seconds; preserve explicit bezier controlPoints.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "expectedRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "requestId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 120
          },
          "trackId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "elementId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "keyframes": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "time": {
                    "type": "number",
                    "minimum": 0
                  },
                  "value": {
                    "type": "number"
                  },
                  "easing": {
                    "type": "string",
                    "enum": [
                      "none",
                      "linear",
                      "ease",
                      "ease-in",
                      "ease-out",
                      "ease-in-out",
                      "quad-in",
                      "quad-out",
                      "cubic-in",
                      "cubic-out",
                      "quad-ease",
                      "cubic-ease",
                      "circular-ease",
                      "rebound-in",
                      "rebound-out",
                      "bezier"
                    ]
                  },
                  "controlPoints": {
                    "type": "object",
                    "properties": {
                      "x1": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "y1": {
                        "type": "number"
                      },
                      "x2": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "y2": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "x1",
                      "y1",
                      "x2",
                      "y2"
                    ]
                  }
                },
                "additionalProperties": false,
                "required": [
                  "time",
                  "value"
                ]
              },
              "minItems": 2,
              "maxItems": 10000
            }
          }
        },
        "required": [
          "projectId",
          "expectedRevision",
          "requestId",
          "trackId",
          "elementId",
          "keyframes"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    },
